
[Unit]
Description=LogiRed - Microservicio de Envios
After=network.target

[Service]
Type=simple
User=nodeapps
Group=nodeapps
WorkingDirectory=/srv/logired/app/ms-envios
EnvironmentFile=/srv/logired/app/ms-envios/.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
